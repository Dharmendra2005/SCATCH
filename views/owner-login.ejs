<%- include('./partials/header') %>
<% if(error && error.length>0){ %>
<div id="flash-error"
  class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500 z-50 transition-opacity duration-300">
  <span class="inline-block mt-1 mb-1 text-white"> <%= error %> </span>
</div>
<% } %>
<% if(success && success.length > 0){ %>
<div id="flash-success"
  class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-green-500 z-50 transition-opacity duration-300">
  <span class="inline-block mt-1 mb-1 text-white"> <%= success[0] %> </span>
</div>
<% } %>
<script>
  setTimeout(() => {
    const flashError = document.getElementById('flash-error');
    const flashSuccess = document.getElementById('flash-success');
    [flashError, flashSuccess].forEach(el => {
      if (el) {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 300);
      }
    });
  }, 3000);
</script>
<div class="w-full min-h-screen flex items-center justify-center px-20">
    <div class="3/4 flex items-center justify-center gap-5">
        <div class="w-full px-20">
            <h4 class="text-3xl capitalize mb-5">Admin Access</h4>
            <form class action="/login" method="post">
                <input
                    class="block bg-zinc-100 w-full px-2 py-2 border-[1px] rounded-md mb-3 border-zinc-200 text-black"
                    type="username" placeholder="Username" name="username"
                    required>
                <input
                    class="block bg-zinc-100 w-full px-2 py-2 border-[1px] rounded-md mb-3 border-zinc-200 text-black"
                    type="email" placeholder="Email" name="email" required>
                <input
                    class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200 text-black"
                    type="password" placeholder="Password" name="password"
                    required>
                <input
                    class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white"
                    type="submit" value="Login">
            </form>
        </div>
        <div class="w-1/2 ">
            <img
                src="/images/manager.png"
                alt="Manager"
                class="w-490 h-80 " />
        </div>
    </div>
</div>
<%- include('./partials/footer') %>