<%- include('./partials/header') %>
<div class="pt-20 px-4 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="  p-4 rounded-lg mb-6">
            <h1 class="text-2xl font-bold">Customer Orders Dashboard</h1>
            <p class>View all customers and their order
                details</p>
        </div>

        <% if(users.length > 0) { %>
        <div class="space-y-6">
            <% users.forEach(function(user){ %>
            <div class=" border rounded-lg shadow-md overflow-hidden">
                <!-- User Header -->
                <div class=" p-4 border-b">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-semibold ">
                                <%= user.fullname || user.username ||
                                'Unknown User' %>
                            </h2>
                            <p class>📧 <%= user.email %></p>
                            <% if (user.contact) { %>
                            <p class>📱 <%= user.contact %></p>
                            <% } %>
                        </div>
                        <div class="text-right">
                            <span
                                class="  px-3 py-1 rounded-full text-sm font-medium">
                                <%= user.orders.length %> Orders
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Orders List -->
                <div class="p-4">
                    <h3 class="font-semibold  mb-3">Order
                        History:</h3>
                    <% if (user.orders && user.orders.length > 0) { %>
                    <div class="space-y-4">
                        <% user.orders.forEach(function(order, orderIndex) { %>
                        <div
                            class="border border-gray-200 rounded-lg p-4 ">
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <h4 class="font-medium ">Order
                                        #<%= orderIndex + 1 %></h4>
                                    <% if (order.createdAt) { %>
                                    <p class="text-sm ">
                                        📅 <%= new
                                        Date(order.createdAt).toLocaleDateString()
                                        %>
                                        at <%= new
                                        Date(order.createdAt).toLocaleTimeString()
                                        %>
                                    </p>
                                    <% } %>
                                </div>
                                <div class="text-right">
                                    <% if (order.paymentMethod) { %>
                                    <p class="text-sm  mb-1">via
                                        <%= order.paymentMethod %></p>
                                    <% } %>
                                    <% if (order.totalAmount) { %>
                                    <p
                                        class="text-lg font-bold ">₹<%=
                                        order.totalAmount %></p>
                                    <% } %>
                                    <% if (order.paymentStatus) { %>
                                    <span
                                        class="text-xs px-2 py-1 rounded-full 
                                                            <% if (order.paymentStatus === 'paid') { %>bg-green-100 text-green-800<% } else { %>bg-yellow-100 text-yellow-800<% } %>">
                                        <%= order.paymentStatus %>
                                    </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Products in this order -->
                            <% if (order.items && order.items.length > 0)
                            { %>
                            <div class=" rounded-lg p-3">
                                <h5
                                    class="font-medium  mb-2">Products
                                    Ordered:</h5>
                                <div class="space-y-2">
                                    <% order.items.forEach(function(item) {
                                    %>
                                    <div
                                        class="flex items-center justify-between p-2  rounded">
                                        <div
                                            class="flex items-center space-x-3">
                                            <% if (item.product &&
                                            item.product.image) { %>
                                            <img
                                                src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                                                alt="<%= item.product.name %>"
                                                class="w-12 h-12 object-cover rounded border">
                                            <% } else { %>
                                            <div
                                                class="w-12 h-12  rounded flex items-center justify-center">
                                                <i
                                                    class="ri-image-line "></i>
                                            </div>
                                            <% } %>
                                            <div>
                                                <p
                                                    class="font-medium">
                                                    <%= item.product ?
                                                    item.product.name :
                                                    'Unknown Product' %>
                                                </p>
                                                <p
                                                    class="text-sm ">
                                                    Quantity: <%= item.quantity
                                                    || 1 %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <p
                                                class="font-semibold ">
                                                ₹<%= item.product ?
                                                item.product.price : 0 %>
                                            </p>
                                            <p class="text-sm ">
                                                Total: ₹<%= (item.product ?
                                                item.product.price : 0) *
                                                (item.quantity || 1) %>
                                            </p>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                            <% } else { %>
                            <div
                                class=" rounded-lg p-3 text-center ">
                                <p>No product details available for this
                                    order</p>
                            </div>
                            <% } %>

                            <!-- Delivery Address -->

                            <div class="flex">
                                <% if (order.address) { %>
                                <div
                                    class=" w-[70%] mt-3 pt-3  border-gray-200">
                                    <h5
                                        class="font-medium mb-1">Delivery
                                        Address:</h5>
                                    <div
                                        class="text-sm p-3 rounded border">
                                        <% if (typeof order.address === 'object'
                                        &&
                                        order.address !== null) { %>
                                        <!-- Display populated address object -->
                                        <% if (order.address.name) { %>
                                        <p class="font-medium"><%=
                                            order.address.name %></p>
                                        <% } %>
                                        <% if (order.address.Address ||
                                        order.address.address) { %>
                                        <p><%= order.address.Address ||
                                            order.address.address %></p>
                                        <% } %>
                                        <% if (order.address.House_no) { %>
                                        <p><%= order.address.House_no %></p>
                                        <% } %>
                                        <% if (order.address.PinCode) { %>
                                        <p>PIN: <%= order.address.PinCode %></p>
                                        <% } %>
                                        <% if (order.address.Mobile_no) { %>
                                        <p>📱 <%= order.address.Mobile_no %></p>
                                        <% } %>
                                        <% if (order.address.addressType) { %>
                                        <span
                                            class="inline-block px-2 py-1 text-xs rounded mt-2">
                                            <%= order.address.addressType %>
                                        </span>
                                        <% } %>
                                        <% } else { %>
                                        <!-- Display string address -->
                                        <p><%= order.address %></p>
                                        <% } %>
                                    </div>
                                </div>
                                <% } else { %>
                                <div class="mt-3 pt-3 border-t border-gray-200">
                                    <p class="text-center text-sm">No
                                        delivery address available for this
                                        order</p>
                                </div>
                                <% } %>
                                <div
                                    class="w-[30%] mt-3 pt-3 flex justify-end items-center">
                                    <button id="Hide"
                                        onclick="removeProduct('<%= user._id %>', '<%= order.createdAt.getTime() %>')"
                                        class="h-10 w-20 bg-red-400 text-white rounded hover:bg-red-800"
                                        type="button">Hide</button>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div
                        class=" rounded-lg p-3 text-center ">
                        <p>No orders found for this customer</p>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <div class="rounded-lg shadow-md p-12 text-center">
            <div
                class="w-16 h-16 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                <i class="ri-shopping-bag-line text-2xl "></i>
            </div>
            <h3 class="text-lg font-medium mb-2">No Orders
                Yet</h3>
            <p class>No customers have placed orders yet.</p>
        </div>
        <% } %>
    </div>
</div>
<%- include('./partials/footer')%>

<script>
    function removeProduct(userId, orderId){
        if(!confirm("Hide this order from dashboard?")) return;
        fetch(`/owners/deleteOrder/${userId}/${orderId}`, {method: 'DELETE'})
        .then(response => response.json())
        .then(data => {
            if(data.success) {
                location.reload();
            } else {
                alert('Failed to hide order: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Something went wrong!');
        });
    }



    const hide = document.getElementById('Hide');
</script>
