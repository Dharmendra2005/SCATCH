<%- include('./partials/header') %>
<div class="w-full h-screen flex items-start px-18 py-20 bg-primary">
    <div class="w-[25%] h-screen p-6 border-r border-gray-200 flex flex-col text-sm">

    <!-- Sort By Section -->
    <div class="flex flex-col gap-2 mb-8">
        <h3 class="font-semibold uppercase tracking-wider text-xs">Sort by</h3>
        <form action="/shop" method="get">
            <select class="w-full border rounded-md px-3 py-2 text-black"
                name="sortby" onchange="this.form.submit()">
                <option value="popular">Popular</option>
                <option value="newest">Newest</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
            </select>
        </form>
    </div>

    <!-- Categories -->
    <div class="flex flex-col gap-3 mb-12">
        <a class="hover:text-blue-600 font-medium" href="/shop?category=new">New Collection</a>
        <a class="hover:text-blue-600 font-medium" href="/shop">All Products</a>
        <a class="hover:text-blue-600 font-medium" href="/shop?discount=true">Discounted Products</a>
    </div>

    <!-- Bottom section -->
     <div class="flex flex-col gap-3 pt-4 border-t border-gray-500">
        <h3 class="font-semibold uppercase tracking-wider text-xs">Filter by</h3>
        <a class="hover:text-blue-600">In Stock</a>
        <a class="hover:text-blue-600">On Sale</a>
    </div>

</div>

    <div class="w-[75%] flex flex-col gap-3 h-screen overflow-y-auto">
        <% if(products && products.length > 0) { %>
        <!-- Added items-start to container -->
        <div class="flex items-start gap-2 flex-wrap">
            <% products.forEach(function(product){ %>
            <!-- Set width to 1/4 (25%) and remove fixed width on product if any -->
            <div class="w-[calc(25%-8px)] flex-shrink-0">
                <div id="item"
                    class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                    <% if(product.image) { %>
                    <img class="h-[12rem] object-contain"
                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                        alt="<%= product.name %>">
                    <% } else { %>
                    <span class="text-gray-500">No Image</span>
                    <% } %>
                </div>
                <div
                    class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-3 py-4 text-[<%= product.textcolor%>]">
                    <div>
                        <h3 class="text-sm">
                            <%= product.name %>
                        </h3>
                        <h4 class="text-sm">₹ <%= product.price %></h4>
                        <% if(product.discount > 0) { %>
                        <p class="text-sm text-green-600"><%= product.discount
                            %>% OFF</p>
                        <% } %>
                    </div>
                     <% const isInCart = cartProductIds.includes(product._id.toString()); %>
                    <button
                        type="button"
                        id="cartBtn-<%= product._id %>"
                        onclick="addToCart('<%= product._id %>')"
                        <%= isInCart ? "disabled" : "" %>
                        class="w-9 h-9 flex items-center justify-center rounded-full text-black mr-10 transition-colors <%= isInCart ? 'bg-green-100' : 'bg-white hover:bg-gray-600' %>">
                        <i id="cartIcon-<%= product._id %>" class="<%= isInCart ? 'ri-check-line text-lg text-green-600' : 'ri-add-line text-lg' %>"></i>
                    </button>

                </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="w-full h-64 flex items-center justify-center">
            <div class="text-center">
                <h3 class="text-2xl mb-2">No Products Found</h3>
                <p class="text-secondary">Try adjusting your filters or check
                    back later</p>
                <a href="/products/create-sample"
                    class="mt-4 inline-block px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">Create
                    Sample Product</a>
            </div>
        </div>
        <% } %>
    </div>
</div>
<%- include('./partials/footer') %>

<script>
function addToCart(productId) {
  const btn = document.getElementById(`cartBtn-${productId}`);
  const icon = document.getElementById(`cartIcon-${productId}`);
  
  // Disable button while processing
  btn.disabled = true;
   fetch(`/addtocart/${productId}`, {
    method: "post",
    credentials: "include"
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      // Change icon to checkmark
      icon.className = "ri-check-line text-lg text-green-600";
      btn.classList.add("bg-green-100");
      showToast("Added to Cart!", "success");
    } else {
      // Already in cart - show checkmark too
      icon.className = "ri-check-line text-lg text-green-600";
      btn.classList.add("bg-green-100");
      showToast("Product already in cart", "error");
      btn.disabled = true;
    }
  })
  .catch(err => {
    console.error(err);
    showToast("Something went wrong", "error");
    btn.disabled = false;
  });
}


function showToast(message, type) {
  // Create toast element
  const toast = document.createElement("div");
  toast.className = `fixed top-20 right-4 px-6 py-3 rounded-lg text-white z-50 transition-opacity duration-300 ${
    type === "success" ? "bg-green-500" : "bg-red-500"
  }`;
  toast.textContent = message;
  
  document.body.appendChild(toast);
  
  // Remove after 3 seconds
  setTimeout(() => {
    toast.style.opacity = "0";
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}
</script>
